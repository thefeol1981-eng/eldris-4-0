HOST=127.0.0.1
PORT=5000
DEBUG=true
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
DATABASE_PATH=eldris.sqlite3
COMMAND_TIMEOUT_SECONDS=2.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- device ingress ----------------------------------------------------------
# The ESP32 nodes (wrist band, home climate, drive board, chatbot) cannot hold a
# caregiver session, so they present this shared key in the X-Device-Key header.
# Empty means the ingest endpoints stay session-only.
DEVICE_API_KEY=

# --- ESP32 #1: left wrist band ------------------------------------------------
# Heart rate, blood oxygen, body temperature, tremor and falls, all on one board
# worn on the left wrist. There is no second band and no side setting.
BAND_BATTERY_PCT=88

# --- ESP32 #2: drive board ----------------------------------------------------
# Its address on the LAN. http:// is assumed; no trailing slash or path.
DRIVE_ESP_IP=192.168.1.40
DRIVE_TIMEOUT_SECONDS=2.5
DRIVE_POLL_SECONDS=2.0

# --- ESP32 #3: home climate ---------------------------------------------------
# The DHT22 board posts to /api/readings with DEVICE_API_KEY, so it is not polled.
# Set the address only to show it next to the device name.
ESP32_HOME_IP=

# --- ESP32 #4: chatbot (microphone + amplifier + speaker) ---------------------
# The board posts recordings to /api/voice/audio and the Pi transcribes them.
# Set the address only to show it next to the device name.
VOICE_ESP_IP=
# The five spoken phrases that trigger the help escalation. Comma separated.
HELP_KEYWORDS=help,help me,please help,i need help,i have fallen
# How long the board keeps the audio locally after a help phrase.
HELP_RECORD_SECONDS=30
# One shouted sentence must not open five alerts.
HELP_COOLDOWN_SECONDS=45
# Seconds the robot creeps towards the patient after a help phrase; 0 disables motion.
HELP_APPROACH_SECONDS=4
# The room the patient is usually in, used when a help phrase is heard.
VOICE_PATIENT_ROOM=bedroom
VOICE_OFFLINE_SECONDS=120
VOICE_AUDIO_MAX_BYTES=900000
# Speech-to-text for the chatbot board's recordings.
VOSK_MODEL=vosk-model-small-en-us

# --- ESP32-CAM: front and rear body cameras -----------------------------------
# Two boards, one per camera. Each serves /stream and /snapshot on port 81.
CAMERA_ESP_FRONT_IP=
CAMERA_ESP_REAR_IP=
CAMERA_ESP_PORT=81
CAMERA_ESP_STREAM_PATH=/stream
CAMERA_ESP_SNAPSHOT_PATH=/snapshot
CAMERA_TIMEOUT_SECONDS=5
CAMERA_SNAPSHOT_MAX_BYTES=4000000

# --- speaker (text to speech on the Pi) --------------------------------------
# Leave empty to auto-detect espeak-ng, espeak or say. {text} is the phrase.
TTS_COMMAND=
TTS_MAX_CHARS=400
TTS_TIMEOUT_SECONDS=15

# --- assistant (optional cloud model; answer rules stay local) ---------------
# Leave every key empty to keep the assistant fully offline. auto picks whichever
# key is present.
CHAT_PROVIDER=auto
CHAT_MODEL=
CHAT_TIMEOUT_SECONDS=12
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- wrist band: tremor -------------------------------------------------------
TREMOR_LOW_HZ=4.0
TREMOR_HIGH_HZ=12.0
TREMOR_AMPLITUDE_G=0.02
TREMOR_SUSTAIN_S=2.0
TREMOR_RELEASE_S=1.5
TREMOR_HIGH_G=0.10
TREMOR_MEDIUM_G=0.05
TREMOR_WINDOW_S=1.5

# --- wrist band: falls --------------------------------------------------------
FALL_IMPACT_G=0.8
FALL_FREEFALL_G=0.45
FALL_CONFIRM_S=2.5
FALL_QUIET_G=0.06
FALL_TILT_DEG=45.0
FALL_RECOVER_G=0.25
FALL_COOLDOWN_S=10.0
MOTION_OFFLINE_SECONDS=15.0
MOTION_SAMPLE_HZ=20
MOTION_ALERT_COOLDOWN_SECONDS=30
